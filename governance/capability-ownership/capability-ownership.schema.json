{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow capability responsibility assignments",
  "type": "object",
  "required": [
    "workflow_id",
    "version",
    "assignments"
  ],
  "properties": {
    "workflow_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "owner",
          "reviewers",
          "approver"
        ],
        "properties": {
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "contributors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consultants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approver": {
            "type": "object",
            "required": [
              "authority",
              "required_when"
            ],
            "properties": {
              "authority": {
                "type": "string",
                "minLength": 1
              },
              "required_when": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
