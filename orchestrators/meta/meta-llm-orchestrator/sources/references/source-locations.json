{
  "schema_version": 1,
  "description": "Host-neutral logical identities; location hints are not access grants or proof of executable tools.",
  "sources": [
    {
      "id": "llm-instruction-registry",
      "type": "agent-instruction-registry",
      "identity": {
        "namespace": "EVEI2YONE",
        "name": "LLM-Instruction-Registry"
      },
      "locations": [
        {
          "provider": "github",
          "repository": "EVEI2YONE/LLM-Instruction-Registry",
          "url": "https://github.com/EVEI2YONE/LLM-Instruction-Registry"
        }
      ],
      "branch_hint": "main",
      "revision_policy": "resolve-immutable-commit-at-use",
      "paths": {
        "registry": "registry.json",
        "search": "scripts/search_registry.py",
        "lookup": "scripts/lookup_sections.py",
        "governance": "governance/",
        "schemas": "schemas/"
      },
      "access_preference": [
        "connected-repository",
        "local-checkout",
        "public-read",
        "supplied-snapshot"
      ],
      "unavailable_behavior": "mark-not-verified"
    }
  ]
}
