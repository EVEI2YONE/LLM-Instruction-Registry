{
  "openapi": "3.1.0",
  "info": {
    "title": "Instruction Registry Agent Gateway Contract",
    "version": "0.1.0",
    "description": "PROPOSED external runtime API; no service is deployed. All endpoints require authentication, project scoping, authorization and audit."
  },
  "servers": [
    {
      "url": "https://your-authorized-gateway.example.invalid",
      "description": "Placeholder only; replace with controlled deployment"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque/JWT"
      }
    },
    "schemas": {
      "SubmitTask": {
        "type": "object",
        "required": [
          "project_id",
          "task",
          "context_ref"
        ],
        "properties": {
          "project_id": {
            "type": "string"
          },
          "task": {
            "$ref": "#/components/schemas/SubagentTask"
          },
          "context_ref": {
            "type": "string"
          }
        }
      },
      "SubagentTask": {
        "type": "object",
        "required": [
          "run_id",
          "task_id",
          "package_id",
          "package_version",
          "objective",
          "idempotency_key"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "package_id": {
            "type": "string"
          },
          "package_version": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "parent_task_id": {
            "type": "string"
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limits": {
            "type": "object"
          }
        }
      },
      "TaskStatus": {
        "type": "object",
        "required": [
          "run_id",
          "task_id",
          "status"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "complete",
              "blocked",
              "failed",
              "cancelled",
              "needs-approval"
            ]
          },
          "result_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_owner": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "paths": {
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "Get measured capabilities of authenticated runner",
        "responses": {
          "200": {
            "description": "Runtime capability report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/v1/tasks": {
      "post": {
        "operationId": "submitTask",
        "summary": "Submit idempotent authorized delegation",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitTask"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued or existing task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskStatus"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions"
          },
          "409": {
            "description": "Revision or ownership conflict"
          },
          "422": {
            "description": "Invalid contract or unsupported capability"
          }
        }
      }
    },
    "/v1/tasks/{task_id}": {
      "get": {
        "operationId": "getTask",
        "summary": "Read own project task status",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskStatus"
                }
              }
            }
          },
          "404": {
            "description": "Not found or not visible"
          }
        }
      }
    },
    "/v1/tasks/{task_id}/cancel": {
      "post": {
        "operationId": "cancelTask",
        "summary": "Request cancellation, record late results as provisional",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Cancellation requested"
          },
          "403": {
            "description": "Not authorized"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/v1/contexts/{context_id}": {
      "get": {
        "operationId": "getContext",
        "summary": "Read immutable authorized context revision",
        "parameters": [
          {
            "in": "path",
            "name": "context_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "revision",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Context envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Not authorized"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/v1/artifacts/{artifact_id}": {
      "get": {
        "operationId": "getArtifact",
        "summary": "Read authorized artifact metadata and content reference",
        "parameters": [
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "revision",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Artifact record",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "403": {
            "description": "Not authorized"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/v1/artifacts/{artifact_id}/revisions": {
      "post": {
        "operationId": "commitArtifactRevision",
        "summary": "Compare-and-swap artifact metadata; no automatic approval",
        "parameters": [
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Expected current revision or ETag"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Revision committed"
          },
          "403": {
            "description": "Not authorized"
          },
          "409": {
            "description": "Stale revision"
          }
        }
      }
    },
    "/v1/approvals/{approval_id}": {
      "get": {
        "operationId": "getApproval",
        "summary": "Read verified human approval bound to exact artifact revision",
        "parameters": [
          {
            "in": "path",
            "name": "approval_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approval state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  }
}
