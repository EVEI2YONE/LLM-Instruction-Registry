{
  "openapi": "3.1.0",
  "info": {
    "title": "Lookup-first Agent Gateway Reference API",
    "version": "0.2.0",
    "description": "Implemented by runtime/gateway.py as a loopback development gateway. Production HTTPS, identity, deployment, native provider adapters and approval issuance require separately verified integrations. Bearer token bindings must include projects, scopes and run_ids."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765",
      "description": "Verified local reference service; not an Internet endpoint"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Task": {
        "type": "object",
        "required": [
          "run_id",
          "task_id",
          "package_id",
          "package_version",
          "objective",
          "context_ref",
          "idempotency_key",
          "required_capabilities",
          "permissions",
          "limits"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "package_id": {
            "type": "string"
          },
          "package_version": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "context_ref": {
            "type": "string",
            "description": "Immutable context ID, optionally @revision"
          },
          "idempotency_key": {
            "type": "string"
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "max_depth": {
                "type": "integer"
              },
              "max_parallel": {
                "type": "integer"
              }
            }
          }
        }
      },
      "Context": {
        "type": "object",
        "required": [
          "run_id",
          "task_id",
          "context_id",
          "revision",
          "project_revision",
          "objective",
          "authoritative_inputs",
          "artifact_refs",
          "permissions"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "context_id": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "project_revision": {
            "type": "string"
          },
          "objective": {
            "type": "string"
          },
          "authoritative_inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifact_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Immutable artifact ID, optionally @revision"
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/healthz": {
      "get": {
        "security": [],
        "summary": "Local liveness only",
        "responses": {
          "200": {
            "description": "Available"
          }
        }
      }
    },
    "/v1/capabilities": {
      "get": {
        "summary": "Measured local capabilities",
        "parameters": [
          {
            "in": "query",
            "name": "project_id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Capabilities for authorized project"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/v1/packages/resolve": {
      "get": {
        "summary": "Search registry metadata, not all package source contents",
        "parameters": [
          {
            "in": "query",
            "name": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "project_id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked package candidates"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/v1/contexts": {
      "post": {
        "summary": "Persist immutable, run-scoped context revision",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project_id",
                  "envelope"
                ],
                "properties": {
                  "project_id": {
                    "type": "string"
                  },
                  "envelope": {
                    "$ref": "#/components/schemas/Context"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Context ID and SHA256"
          },
          "403": {
            "description": "Forbidden"
          },
          "409": {
            "description": "Revision conflict"
          }
        }
      }
    },
    "/v1/contexts/{context_id}": {
      "get": {
        "summary": "Read run-authorized context revision",
        "parameters": [
          {
            "in": "path",
            "name": "context_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "project_id",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "revision",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Context"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Absent"
          }
        }
      }
    },
    "/v1/tasks": {
      "post": {
        "summary": "Submit idempotent delegated task to a configured local process worker",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project_id",
                  "task"
                ],
                "properties": {
                  "project_id": {
                    "type": "string"
                  },
                  "task": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Invalid"
          },
          "403": {
            "description": "Permission or authority denied"
          },
          "409": {
            "description": "Idempotency conflict"
          },
          "503": {
            "description": "Worker not configured"
          }
        }
      }
    },
    "/v1/tasks/{task_id}": {
      "get": {
        "summary": "Read run-scoped task status",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "project_id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task status/result"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Absent"
          }
        }
      }
    },
    "/v1/tasks/{task_id}/cancel": {
      "post": {
        "summary": "Best-effort cancellation (late effects may require reconciliation)",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project_id"
                ],
                "properties": {
                  "project_id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Cancellation status"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Absent"
          }
        }
      }
    },
    "/v1/artifacts/{artifact_id}": {
      "get": {
        "summary": "Read run/project authorized artifact metadata and base64 content",
        "parameters": [
          {
            "in": "path",
            "name": "artifact_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "project_id",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "revision",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Artifact metadata and content_base64"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Absent"
          }
        }
      }
    }
  }
}
