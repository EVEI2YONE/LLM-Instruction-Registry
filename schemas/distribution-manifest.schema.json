{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Derived distribution manifest (proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "package_version",
    "variant",
    "canonical_revision",
    "canonical_archive_sha256",
    "included",
    "omitted",
    "build",
    "runtime_requirements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "package_id": {
      "type": "string"
    },
    "package_version": {
      "type": "string"
    },
    "variant": {
      "enum": [
        "portable",
        "connected",
        "prompt"
      ]
    },
    "canonical_revision": {
      "type": "string"
    },
    "canonical_archive_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "included": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "omitted": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "reason"
        ],
        "properties": {
          "ref": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "build": {
      "type": "object",
      "required": [
        "tool",
        "tool_revision",
        "reproducible"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "tool_revision": {
          "type": "string"
        },
        "reproducible": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "runtime_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
