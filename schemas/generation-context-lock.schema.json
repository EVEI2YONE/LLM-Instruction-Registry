{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generation context lock (proposal)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "sources",
    "governance",
    "runtime",
    "resolution",
    "context_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generator": {
      "type": "object",
      "required": [
        "package",
        "version",
        "source_revision"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "source_revision": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "revision",
          "consumed_paths",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "consumed_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "verified",
              "provisional",
              "unavailable"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "governance": {
      "type": "object",
      "required": [
        "status",
        "approval_boundary"
      ],
      "properties": {
        "status": {
          "enum": [
            "approved-injected",
            "approved-not-injected",
            "draft-not-injected",
            "unavailable"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_boundary": {
          "enum": [
            "enforced",
            "blocked",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "target",
        "capabilities"
      ],
      "properties": {
        "target": {
          "type": "string"
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "verified-available",
              "verified-unavailable",
              "unknown"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": [
        "status",
        "missing",
        "blocked"
      ],
      "properties": {
        "status": {
          "enum": [
            "verified",
            "provisional",
            "blocked"
          ]
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "context_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
