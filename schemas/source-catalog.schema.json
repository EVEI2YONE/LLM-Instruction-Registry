{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Logical external source catalog (proposal)",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "identity",
          "locations",
          "revision_policy",
          "access_order",
          "fallback",
          "authority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "agent-registry",
              "knowledge-catalog",
              "governance",
              "runtime-contracts",
              "project-source"
            ]
          },
          "identity": {
            "type": "object",
            "required": [
              "namespace",
              "name"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "provider"
              ],
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1
                },
                "repository": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "path": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "revision_policy": {
            "type": "object",
            "required": [
              "strategy"
            ],
            "properties": {
              "strategy": {
                "enum": [
                  "resolve-and-pin-commit",
                  "pinned-commit",
                  "pinned-content-digest"
                ]
              },
              "branch_hint": {
                "type": "string"
              },
              "commit": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          },
          "entrypoints": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "access_order": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "connected-repository",
                "local-checkout",
                "web-read",
                "supplied-snapshot"
              ]
            }
          },
          "fallback": {
            "enum": [
              "unavailable-not-verified",
              "bundled-snapshot"
            ]
          },
          "authority": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
