{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dynamic delegated subagent task",
  "type": "object",
  "required": [
    "run_id",
    "task_id",
    "package_id",
    "package_version",
    "objective",
    "context_ref",
    "idempotency_key",
    "required_capabilities",
    "permissions",
    "limits"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "package_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "context_ref": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "max_depth",
        "max_parallel"
      ],
      "properties": {
        "max_depth": {
          "type": "integer",
          "minimum": 0
        },
        "max_parallel": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "token_budget": {
          "type": "integer",
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "approval_ref": {
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "complete",
        "blocked",
        "failed",
        "cancelled"
      ]
    }
  },
  "additionalProperties": false
}
