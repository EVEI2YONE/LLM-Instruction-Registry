{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atomic Catalog Knowledge Gap",
  "type": "object",
  "required": [
    "gap_id",
    "question",
    "disposition",
    "catalog_baseline_revision",
    "searched_paths",
    "target_evidence",
    "priority",
    "owner",
    "status"
  ],
  "properties": {
    "gap_id": {
      "type": "string"
    },
    "question": {
      "type": "string"
    },
    "disposition": {
      "enum": [
        "already_sufficient",
        "clarify_existing",
        "extend_existing",
        "create_distinct_entry",
        "research_needed",
        "implementation_missing",
        "conflict_or_deprecation"
      ]
    },
    "catalog_baseline_revision": {
      "type": "string"
    },
    "searched_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "enum": [
        "critical",
        "high",
        "medium",
        "exploratory"
      ]
    },
    "owner": {
      "type": "string"
    },
    "status": {
      "enum": [
        "open",
        "planned",
        "provisional",
        "resolved",
        "blocked"
      ]
    },
    "batch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
